# Shopify Storefront API settings used by the jacket builder.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# Optional when the store permits unauthenticated public cart creation.
VITE_SHOPIFY_STOREFRONT_TOKEN=
VITE_SHOPIFY_API_VERSION=2026-07

# Map every edition and size to its correctly priced Shopify ProductVariant ID.
VITE_SHOPIFY_JACKET_VARIANTS={"Classic":{"S":"gid://shopify/ProductVariant/000000000001","M":"gid://shopify/ProductVariant/000000000002","L":"gid://shopify/ProductVariant/000000000003","XL":"gid://shopify/ProductVariant/000000000004","2XL":"gid://shopify/ProductVariant/000000000005","3XL":"gid://shopify/ProductVariant/000000000006"},"Footballers":{"S":"gid://shopify/ProductVariant/000000000101","M":"gid://shopify/ProductVariant/000000000102","L":"gid://shopify/ProductVariant/000000000103","XL":"gid://shopify/ProductVariant/000000000104","2XL":"gid://shopify/ProductVariant/000000000105","3XL":"gid://shopify/ProductVariant/000000000106"}}
