# Shopify Storefront API settings used by the jacket builder.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
VITE_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_access_token
VITE_SHOPIFY_API_VERSION=2026-07

# Map every builder size to its Shopify ProductVariant GraphQL ID.
VITE_SHOPIFY_JACKET_VARIANTS={"XXS":"gid://shopify/ProductVariant/000000000001","XS":"gid://shopify/ProductVariant/000000000002","S":"gid://shopify/ProductVariant/000000000003","M":"gid://shopify/ProductVariant/000000000004","L":"gid://shopify/ProductVariant/000000000005","XL":"gid://shopify/ProductVariant/000000000006","2XL":"gid://shopify/ProductVariant/000000000007","3XL":"gid://shopify/ProductVariant/000000000008"}
