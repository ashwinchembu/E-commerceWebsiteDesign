{
  "name": "manoir-kits-storefront",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "VITE_PRIVATE_ACCESS_ENABLED=false vite build",
    "build:private": "VITE_PRIVATE_ACCESS_ENABLED=true vite build",
    "dev": "vite",
    "dev:private": "VITE_PRIVATE_ACCESS_ENABLED=true VITE_FIREBASE_USE_EMULATORS=true vite",
    "firebase:deploy": "firebase deploy --only functions,firestore:rules,firestore:indexes",
    "firebase:emulators": "firebase emulators:start --project demo-manoir-kits",
    "firebase:test": "npm test --prefix functions",
    "test:jacket-layout": "node --test test/*.test.mjs",
    "footballer": "node scripts/shopify-footballer.mjs",
    "shopify:feedback:setup": "node scripts/setup-shopify-feedback.mjs",
    "shopify:saved-jackets:setup": "node scripts/setup-shopify-saved-jackets.mjs",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:jacket-layout && npm run build && npm run firebase:test",
    "secure": "npm run build:private"
  },
  "dependencies": {
