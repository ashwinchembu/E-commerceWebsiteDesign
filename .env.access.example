# Generate long random values for production; never commit the real secrets.
ACCESS_ADMIN_SECRET=replace-with-a-long-random-admin-key
ACCESS_SESSION_SECRET=replace-with-at-least-32-random-bytes
INITIAL_OWNER_ACCESS_CODE=MK-XXXXXXXX-XXXX-XXXX-XXXX-XXXX

# Set to 1 only when deployed behind a trusted reverse proxy or hosting platform.
TRUST_PROXY=1

# Raw IP and browser/device access logs are automatically deleted after this period.
ACCESS_EVENT_RETENTION_DAYS=30
PORT=8787
